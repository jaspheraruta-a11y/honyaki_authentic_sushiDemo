# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Optional: App features seamless fallback to local persistent store)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# PHILIPPINE PAYMENT GATEWAY CREDENTIALS (e.g. Maya / PayMongo / GCash Merchant)
VITE_PAYMENT_GATEWAY_PUBLIC_KEY="pk_live_or_test_key"
